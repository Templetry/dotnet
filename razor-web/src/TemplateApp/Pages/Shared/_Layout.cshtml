<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Template App</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-page="/Index">Template App</a>
        <nav aria-label="Main">
            <ul>
                @foreach (var link in Navigation.Links)
                {
                    <li><a asp-page="@link.Page">@link.Text</a></li>
                }
            </ul>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>© @DateTime.UtcNow.Year Template App</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
